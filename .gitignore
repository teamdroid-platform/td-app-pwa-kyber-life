# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.agent
debug.ts
test-update-phone.ts
lint-results.txt
ts_errors.txt
supabase/.temp/

# AI agent cache
.gemini/

# Temporary agent scratch files
/scratch/

# Git worktrees aislados (superpowers:using-git-worktrees)
/.worktrees/

# SWC compiler cache
.swc/

# Sentry Config File
.env.sentry-build-plugin

# graphify: el grafo SÍ se versiona, así que al clonar ya viene construido.
# Solo se ignora el cache de extracción: es interno y se rehace solo.
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_root
# manifest.json cambia (mtimes/hashes) en cada rebuild aunque el grafo no cambie:
# versionarlo deja el arbol sucio justo despues de cada commit.
graphify-out/manifest.json

# El gitignore global de la máquina ignora .mcp.json y .claude/; acá SÍ los versionamos
# (config MCP y hooks del proyecto), salvo lo personal de cada máquina.
!.mcp.json
!.claude/
.claude/settings.local.json
.claude/**/*.local.*
CLAUDE.local.md
